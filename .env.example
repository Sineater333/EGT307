# -------------------------------------------------------------------------------
# MongoDB Atlas Configuration
# -------------------------------------------------------------------------------
# 1. Copy this file and rename it to '.env'
# 2. Replace <username>, <password>, and <cluster> with your Atlas details.
# 3. IMPORTANT: Go to Atlas -> Network Access and allow '0.0.0.0/0' 
#    so the Minikube cluster can connect.
# -------------------------------------------------------------------------------

ATLAS_URL='mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_ADDRESS>/maintenance_db?retryWrites=true&w=majority&appName=EGT307'